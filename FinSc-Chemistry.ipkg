package FinSc-Chemistry
version = 0.3.0
authors = "Justin Kelly"
brief   = "Layer 5a Molecular & Supramolecular Bonding Chemistry Library."

depends = FinSc-Geometry, FinSc-Multiset, FinSc-Metric-Substrate, FinSc-Multiset-Transform, base, linear
sourcedir = "src"

modules = Chemistry,
          Stage0.Chemistry.ChemistryScaleTransforms,
          Stage0.Chemistry.MacromolecularAssembly,
          Stage0.Chemistry.MolecularAggregation,
          Stage0.Chemistry.PeakBindingEnergy,
          Stage0.Chemistry.PlasmaRecombination,
          Stage0.Chemistry.TripleAlphaNucleosynthesis,
          Stage1.Chemistry.Biomolecules,
          Stage1.Chemistry.HydrogenBonding,
          Stage1.Chemistry.MacromolecularChirality,
          Stage1.Chemistry.MolecularBonding,
          Stage1.Chemistry.WatsonCrickBasePairing

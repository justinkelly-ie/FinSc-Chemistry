package Idris2-Chemistry
version = 0.3.0
authors = "Justin Kelly"
brief   = "Layer 5a Molecular & Supramolecular Bonding Chemistry Library."

depends = base
        , Idris2-Hadron

sourcedir = "src"

modules = Compound.MolecularBonding
        , Compound.HydrogenBonding
        , Compound.WatsonCrickBasePairing
        , Compound.MacromolecularChirality
        , Compound.MacromolecularAssembly
        , Compound.Biomolecules
        , Compound.ChemistryScaleTransforms
        , Compound.MolecularAggregation
        , Math.HydrogenBonding
        , Math.PeakBindingEnergy
        , Math.MacromolecularChirality
        , Math.NucleicAcidBasePairing
        , Math.PlasmaRecombination
        , Math.TripleAlphaNucleosynthesis
